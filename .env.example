DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=trackerTime

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# Secreto compartido para /api/cron/alertas-actividades (header
# x-cron-secret). Mismo valor debe cargarse como secret de GitHub Actions
# (CRON_SECRET) en el repo, ver .github/workflows/alertas-actividades.yml.
# Generar con: openssl rand -hex 32
CRON_SECRET=

# URL publica de la app en produccion, para que el workflow de GitHub
# Actions sepa a donde pegarle (ej. https://tuapp.up.railway.app)
APP_URL=
